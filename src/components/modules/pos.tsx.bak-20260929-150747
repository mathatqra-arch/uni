                data-active={activeCategory === 'all'}
                onClick={() => setActiveCategory('all')}
                aria-pressed={activeCategory === 'all'}
              >
                الكل
              </button>
              {categories.map(c => (
                <button
                  key={c.id}
                  type="button"
                  className={cn(
                    "pos-cat-pill transition-all duration-200 font-medium",
                    activeCategory === c.id && "shadow-sm scale-[1.02]"

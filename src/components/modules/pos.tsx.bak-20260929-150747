'use client'

import { useEffect, useState, useRef, useCallback } from 'react'
import { apiFetch, formatEGP } from '@/lib/api'
import { useCartStore, useAuthStore, useUIStore, useCashSessionStore, type CartItem } from '@/lib/store'
import type { Product, Category, Customer, StockLevel } from '@/lib/types'
import { Input } from '@/components/ui/input'
import { Button } from '@/components/ui/button'
import type { CartState } from '@/lib/store'

type PaymentPayload = { method: string; paid: number; details?: { splits?: Array<{ method: string; amount: number }> } }

type SaleRowLite = Parameters<typeof ReceiptPrint>['0']['sale']

import { Badge } from '@/components/ui/badge'
import { ScrollArea } from '@/components/ui/scroll-area'
import { Separator } from '@/components/ui/separator'
import {
  Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter, DialogDescription
} from '@/components/ui/dialog'
import {
  Sheet, SheetContent, SheetTrigger
} from '@/components/ui/sheet'
import { Label } from '@/components/ui/label'
import { toast } from 'sonner'
import { notifyError } from '@/lib/notify'
import {
  Search, ShoppingCart, Trash2, Plus, Minus, X, User, Tag, Pause, Play,
  CreditCard, Banknote, Wallet, Percent, ChevronLeft,
  ScanLine, Gift, UserPlus, Loader2, Award, ChevronRight
} from 'lucide-react'
import { cn } from '@/lib/utils'
import { ReceiptPrint } from '@/components/pos/receipt-print'
import { ProductCard } from '@/components/pos/product-card'
import { generateUUID } from '@/lib/ids'

export function POSModule() {
  const [products, setProducts] = useState<Product[]>([])
  const [categories, setCategories] = useState<Category[]>([])
  const [search, setSearch] = useState('')
  const [activeCategory, setActiveCategory] = useState('all')
  const [productPage, setProductPage] = useState(0)
  const [productPageSize, setProductPageSize] = useState(12)
  const [loading, setLoading] = useState(false)
  const [paymentOpen, setPaymentOpen] = useState(false)
  const [customerOpen, setCustomerOpen] = useState(false)
  const [discountOpen, setDiscountOpen] = useState(false)
  const [heldOpen, setHeldOpen] = useState(false)
  const [checkoutCustomerOpen, setCheckoutCustomerOpen] = useState(false)
  const [lastSale, setLastSale] = useState<SaleRowLite | null>(null)
  const [cartSheetOpen, setCartSheetOpen] = useState(false)
  // ─── CASH REGISTER GATE ───
  // Sales must not be allowed to start unless a register is open (see
  // handleCreateSale's server-side check in desktop-api.ts, which is the
  // real enforcement). This mirrors that on the UI so the cashier sees a
  // clear message and a way to open the register *before* they build a
  // whole cart and hit "pay" only to be rejected.
  const [registerOpen, setRegisterOpen] = useState<boolean | null>(null)
  const setModule = useUIStore((s) => s.setModule)
  // Loyalty behavior must follow whatever the owner configured in
  // Settings → الولاء (enable/disable, EGP-per-point, minimum to redeem) —
  // previously calcTotals() hardcoded 0.05 EGP/point and there was no
  // minimum-redeem enforcement at all, so editing those settings had no
  // effect on the POS screen.
  const [loyaltySettings, setLoyaltySettings] = useState({ enabled: true, egpPerPoint: 0.05, minRedeem: 0 })
  // Settings → الضرائب → "تفعيل الضريبة". A store-wide off switch, distinct
  // from the per-invoice "تعطيل الضريبة" button below (which stays
  // available for one-off exempt invoices even while tax is on globally).
  // When the owner turns this off, every new invoice starts tax-exempt and
  // the per-invoice toggle is hidden — there is nothing left to toggle.
  const [taxEnabled, setTaxEnabled] = useState(true)
  // Per-product loyalty campaigns (see loyalty.tsx CampaignsTab) — maps
  // productId → bonus points, so the product grid can show "+N نقطة" on
  // whichever products currently have an active campaign.
  const [campaignBonusByProduct, setCampaignBonusByProduct] = useState<Record<string, number>>({})
  // Products redeemable with points instead of cash (loyalty.tsx →
  // "منتجات بالنقاط" tab, stored as a settings JSON blob — see
  // PointsProductsTab). Maps productId → points required.
  const [pointsProductsByProduct, setPointsProductsByProduct] = useState<Record<string, number>>({})
  const [redeemProductTarget, setRedeemProductTarget] = useState<Product | null>(null)
  const [redeemingProduct, setRedeemingProduct] = useState(false)
  const searchRef = useRef<HTMLInputElement>(null)
  // Category row navigation: edge arrows + vertical-wheel → horizontal scroll.
  const catRowRef = useRef<HTMLDivElement>(null)
  const [catScroll, setCatScroll] = useState({ start: true, end: true })

  const updateCatScroll = () => {
    const el = catRowRef.current
    if (!el) return
    const max = el.scrollWidth - el.clientWidth
    if (max <= 4) { setCatScroll({ start: true, end: true }); return }
    const pos = Math.abs(el.scrollLeft)
    setCatScroll({ start: pos <= 4, end: pos >= max - 4 })
  }

  const scrollCats = (dir: 'next' | 'prev') => {
    const el = catRowRef.current
    if (!el) return
    const step = 260
    const rtl = getComputedStyle(el).direction === 'rtl'
    const sign = rtl ? -1 : 1
    el.scrollBy({ left: dir === 'next' ? sign * step : -sign * step, behavior: 'smooth' })
  }

  useEffect(() => { updateCatScroll() }, [categories, loading])

  // Vertical mouse wheel scrolls the category row horizontally (RTL-aware)
  useEffect(() => {
    const el = catRowRef.current
    if (!el) return
    const onWheel = (e: WheelEvent) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault()
        el.scrollLeft -= e.deltaY
      }
    }
    el.addEventListener('wheel', onWheel, { passive: false })
    return () => el.removeEventListener('wheel', onWheel)
  }, [categories])

  // The product grid is paged instead of vertically scrolled so the POS
  // workspace stays visually stable. Page size follows responsive density.
  useEffect(() => {
    const updateProductPageSize = () => {
      // Fit whole rows into the available viewport height so the grid never
      // leaves a large empty band under the last row (and never clips a row).
      const width = window.innerWidth
      const viewportH = window.innerHeight
      // measured card row: ~132px card + 8px gap; chrome = context bar (~70) +
      // toolbar (~48) + categories (~44) + paddings (~34) + pagination (~40)
      const rowH = width < 768 ? 150 : 140
      const chrome = width < 768 ? 260 : 240
      const rows = Math.max(1, Math.floor((viewportH - chrome) / rowH))
      const cols = width < 640 ? 2 : width < 1024 ? 3 : width < 1280 ? 4 : 5
      setProductPageSize(rows * cols)
    }
    updateProductPageSize()
    window.addEventListener('resize', updateProductPageSize)
    return () => window.removeEventListener('resize', updateProductPageSize)
  }, [])

  // Use selectors to prevent unnecessary re-renders when unrelated store fields change
  // (e.g. `note` or `heldSales` updates no longer re-render the entire POS)
  const { user } = useAuthStore()
  const cartItems = useCartStore((s) => s.items)
  const customerId = useCartStore((s) => s.customerId)
  const customerName = useCartStore((s) => s.customerName)
  const customerPhone = useCartStore((s) => s.customerPhone)
  const loyaltyPoints = useCartStore((s) => s.loyaltyPoints)
  const loyaltyRedeem = useCartStore((s) => s.loyaltyRedeem)
  const cartDiscountAmount = useCartStore((s) => s.discountAmount)
  const discountType = useCartStore((s) => s.discountType)
  const cartNote = useCartStore((s) => s.note)
  const heldSales = useCartStore((s) => s.heldSales)
  const taxExempt = useCartStore((s) => s.taxExempt)
  const setTaxExempt = useCartStore((s) => s.setTaxExempt)
  // Actions (stable references — safe to grab whole store once)
  const addItem = useCartStore((s) => s.addItem)
  const removeItem = useCartStore((s) => s.removeItem)
  const updateQuantity = useCartStore((s) => s.updateQuantity)
  const clearCart = useCartStore((s) => s.clearCart)
  const setCustomer = useCartStore((s) => s.setCustomer)
  const setLoyaltyRedeem = useCartStore((s) => s.setLoyaltyRedeem)
  const setDiscount = useCartStore((s) => s.setDiscount)
  const setNote = useCartStore((s) => s.setNote)
  const holdSale = useCartStore((s) => s.holdSale)
  const retrieveHeldSale = useCartStore((s) => s.retrieveHeldSale)
  const removeHeldSale = useCartStore((s) => s.removeHeldSale)

  // Convenience alias for backward compat with existing code that uses `cart.X`
  const cart = {
    items: cartItems,
    customerId,
    customerName,
    customerPhone,
    loyaltyPoints,
    loyaltyRedeem,
    discountAmount: cartDiscountAmount,
    discountType,
    note: cartNote,
    heldSales,
    taxExempt,
    addItem,
    removeItem,
    updateQuantity,
    clearCart,
    setCustomer,
    setLoyaltyRedeem,
    setDiscount,
    setNote,
    holdSale,
    retrieveHeldSale,
    removeHeldSale,
  }

  // Load products & categories
  useEffect(() => {
    loadData()
    checkRegisterStatus()
    loadLoyaltySettings()
    loadCampaignBonuses()
    loadPointsProducts()
    loadTaxSettings()
  }, [])

  const loadTaxSettings = async () => {
    try {
      const data = await apiFetch('/settings')
      const g = data?.grouped?.tax || {}
      const enabled = g['tax.enabled'] !== 'false'
      setTaxEnabled(enabled)
      if (!enabled) setTaxExempt(true)
    } catch {
      // keep default (tax on) — POS should still work if settings fail to load
    }
  }

  const loadPointsProducts = async () => {
    try {
      const data = await apiFetch('/settings')
      const raw = data?.grouped?.loyalty?.['loyalty.pointsProducts']
      const parsed = raw ? JSON.parse(raw) : []
      const map: Record<string, number> = {}
      for (const i of Array.isArray(parsed) ? parsed : []) {
        if (i?.productId) map[i.productId] = i.pointsCost || 0
      }
      setPointsProductsByProduct(map)
    } catch {
      setPointsProductsByProduct({})
    }
  }

  const loadCampaignBonuses = async () => {
    try {
      const campaigns = await apiFetch('/loyalty/campaigns?active=true')
      const map: Record<string, number> = {}
      for (const c of campaigns || []) {
        if (c.productId) map[c.productId] = (map[c.productId] || 0) + (c.bonusPoints || 0)
      }
      setCampaignBonusByProduct(map)
    } catch {
      setCampaignBonusByProduct({})
    }
  }

  const loadLoyaltySettings = async () => {
    try {
      const data = await apiFetch('/settings')
      const g = data?.grouped?.loyalty || {}
      setLoyaltySettings({
        enabled: g['loyalty.enabled'] !== 'false',
        egpPerPoint: parseFloat(g['loyalty.egpPerPoint']) || 0.05,
        minRedeem: parseInt(g['loyalty.minRedeem']) || 0,
      })
    } catch {
      // keep defaults — POS should still work if settings fail to load
    }
  }

  const setGlobalRegisterOpen = useCashSessionStore((s) => s.setRegisterOpen)

  const checkRegisterStatus = async () => {
    try {
      const session = await apiFetch('/cash')
      setRegisterOpen(!!session)
      setGlobalRegisterOpen(!!session)
    } catch {
      // If the check itself fails, don't block the cashier on a UI-only
      // glitch — the server-side guard in handleCreateSale still applies
      // as the real source of truth.
      setRegisterOpen(true)
      setGlobalRegisterOpen(true)
    }
  }

  // Gate for every "start checkout" entry point (keyboard shortcut, the
  // desktop pay button, and the mobile sheet's pay button) — all three
  // funnel through this instead of calling setPaymentOpen directly.
  const startCheckout = () => {
    if (cart.items.length === 0) return
    if (registerOpen === false) {
      toast.error('لازم تفتح الخزنة الأول قبل ما تقدر تبيع', {
        description: 'اضغط هنا للذهاب لشاشة الخزنة',
        action: { label: 'فتح الخزنة', onClick: () => setModule('cash') },
      })
      return
    }
    if (!cart.customerId) {
      setCheckoutCustomerOpen(true)
    } else {
      setPaymentOpen(true)
    }
  }

  // Barcode scanner: rapid keypress detection.
  // Only active when focus is OUTSIDE any input/textarea — the search box
  // below has its own onKeyDown that already handles scans typed into it.
  // (Previously this ran unconditionally too, so scanning while the search
  // box was focused — the normal workflow — added every item to the cart
  // TWICE. isInInput was computed but never actually used to skip.)
  useEffect(() => {
    let buffer = ''
    let lastKeyTime = 0
    const handler = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement
      const isInInput = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA'
      if (isInInput) return

      const now = Date.now()
      if (now - lastKeyTime > 100) buffer = ''
      lastKeyTime = now

      if (e.key === 'Enter' && buffer.length >= 4) {
        e.preventDefault()
        handleBarcode(buffer)
        buffer = ''
      } else if (e.key.length === 1) {
        buffer += e.key
      }
    }
    window.addEventListener('keydown', handler)
    return () => window.removeEventListener('keydown', handler)
  }, [products])

  // Keyboard shortcuts
  useEffect(() => {
    const handler = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement
      if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') return
      if (e.key === 'F2') { e.preventDefault(); searchRef.current?.focus() }
      if (e.key === 'F3') { e.preventDefault(); setCustomerOpen(true) }
      if (e.key === 'F4') { e.preventDefault(); setDiscountOpen(true) }
      if (e.key === 'F5') { e.preventDefault(); handleHold() }
      if (e.key === 'F6') { e.preventDefault(); setHeldOpen(true) }
      if (e.key === 'F8') { e.preventDefault(); startCheckout() }
      if (e.key === 'Escape') { e.preventDefault(); setPaymentOpen(false); setCustomerOpen(false); setDiscountOpen(false) }
    }
    window.addEventListener('keydown', handler)
    return () => window.removeEventListener('keydown', handler)
  }, [cart.items, registerOpen])

  const loadData = async () => {
    setLoading(true)
    try {
      // apiFetch automatically routes to SQLite in desktop mode
      const [prods, cats] = await Promise.all([
        apiFetch('/products?limit=200').catch(() => []),
        apiFetch('/categories').catch(() => []),
      ])

      setProducts(prods || [])
      setCategories(cats || [])
    } catch {
      setProducts([])
      setCategories([])
    } finally {
      setLoading(false)
    }
  }

  const handleBarcode = async (barcode: string) => {
    const code = barcode.trim()
    if (!code) return
    // Safe barcode lookup — try/catch around JSON.parse for malformed barcodes array
    const product = products.find(p => {
      if (p.barcode === code) return true
      if (p.barcodes) {
        try {
          // barcodes may be a JSON string (SQLite TEXT) or already an array
          const extra = typeof p.barcodes === 'string' ? JSON.parse(p.barcodes) : p.barcodes
          return Array.isArray(extra) && extra.includes(code)
        } catch {
          return false
        }
      }
      return false
    })
    if (product) {
      addToCart(product)
      toast.success(`${product.nameAr || product.name} - تمت الإضافة`, { duration: 1500 })
    } else {
      toast.error(`الباركود غير موجود: ${code}`)
    }
    if (searchRef.current) searchRef.current.value = ''
    setSearch('')
  }

  const addToCart = (product: Product) => {
    if (!product.active) { toast.error('المنتج غير مفعل'); return }
    // FIX: this is wired to the whole product card, not just the amber
    // "استبدال بالنقاط" button — so clicking the card again for a product
    // that's already in the cart as a points-redeemed line used to merge
    // straight into cart.addItem's generic quantity++ (see store.ts), with
    // NO points check and NO extra deduction at all. That's how a points
    // item kept growing "even with no points": every second click was a
    // free unit, points balance or not. Route that case through the same
    // checked path as the cart's own "+" stepper instead.
    const existingLine = cart.items.find(i => i.productId === product.id)
    if (existingLine?.isPointsItem) {
      incrementPointsItem(existingLine)
      return
    }
    const stock = product.currentStock ?? (product.stockLevels?.reduce((s: number, l: StockLevel) => s + l.quantity, 0) || 0)
    if (!product.allowNegativeStock && stock <= 0) {
      toast.error('المنتج غير متوفر في المخزون')
      return
    }
    // Stock ceiling: never allow more units than the available stock.
    // (Backend still enforces the same rule server-side; this keeps the
    // UI honest so the cashier never builds an impossible invoice.)
    if (!product.allowNegativeStock && existingLine && existingLine.quantity + 1 > stock) {
      toast.error(`الحد الأقصى المتاح: ${stock} وحدة فقط`, { description: product.nameAr || product.name })
      return
    }
    cart.addItem({
      productId: product.id,
      name: product.name,
      nameAr: product.nameAr ?? undefined,
      barcode: product.barcode ?? undefined,
      sku: product.sku,
      price: product.sellingPrice,
      cost: product.avgCost || product.purchaseCost,
      taxRate: product.taxRate,
      quantity: 1,
      stock,
      image: product.image ?? undefined,
    })
  }

  // "استبدال بالنقاط" — add a points-eligible product to the cart FOR FREE
  // (price 0, no tax) and immediately deduct its points cost from the
  // customer's balance via the same atomic /loyalty/redeem endpoint used
  // in loyalty.tsx (balance validation + idempotency already handled
  // there). Deliberately kept separate from the cart's normal
  // loyaltyRedeem/discount flow — that flow converts points into an EGP
  // discount off the whole bill at loyaltySettings.egpPerPoint; a points
  // product's cost is set independently by the owner and should always
  // come straight off the bill as ٠ ج.م, not as a converted discount.
  const confirmRedeemProduct = async () => {
    const product = redeemProductTarget
    if (!product) return
    const pointsCost = pointsProductsByProduct[product.id] || 0
    if (!cart.customerId) { toast.error('اختر عميل أولاً لاستبدال منتج بالنقاط'); return }
    if ((loyaltyPoints || 0) < pointsCost) {
      toast.error(`رصيد النقاط غير كافٍ. المتاح: ${loyaltyPoints || 0} نقطة`)
      return
    }
    const stock = product.currentStock ?? (product.stockLevels?.reduce((s: number, l: StockLevel) => s + l.quantity, 0) || 0)
    if (!product.allowNegativeStock && stock <= 0) {
      toast.error('المنتج غير متوفر في المخزون')
      return
    }
    setRedeemingProduct(true)
    try {
      const clientTxnId = generateUUID()
      await apiFetch('/loyalty/redeem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Client-Txn-Id': clientTxnId },
        body: JSON.stringify({
          customerId: cart.customerId,
          points: pointsCost,
          note: `استبدال منتج: ${product.nameAr || product.name}`,
          clientTxnId,
        }),
      })
      cart.addItem({
        productId: product.id,
        name: product.name,
        nameAr: `${product.nameAr || product.name} (بالنقاط)`,
        barcode: product.barcode ?? undefined,
        sku: product.sku,
        price: 0,
        cost: product.avgCost || product.purchaseCost,
        taxRate: 0,
        quantity: 1,
        stock,
        image: product.image ?? undefined,
        isPointsItem: true,
        pointsCost,
      })
      // Reflect the new balance locally without a full customer re-fetch.
      setCustomer(cart.customerId, cart.customerName, cart.customerPhone, (loyaltyPoints || 0) - pointsCost)
      toast.success(`تم استبدال ${pointsCost} نقطة بـ ${product.nameAr || product.name}`)
      setRedeemProductTarget(null)
    } catch (e) {
      notifyError(e, { context: 'استبدال النقاط' })
    } finally {
      setRedeemingProduct(false)
    }
  }

  // Add ONE more free unit of an already-in-cart points item — this is the
  // only way to grow its quantity. FIX: the generic "+" stepper used to be
  // wired to every cart line including points lines, so tapping it just
  // bumped `quantity` locally with no re-check and no extra points ever
  // deducted — an unlimited number of free units for the first points
  // spent. Every extra unit now goes through the same atomic
  // /loyalty/redeem call as the first one, so quantity can never outrun
  // what the customer's balance actually covers.
  const incrementPointsItem = async (item: CartItem) => {
    const pointsCost = item.pointsCost || 0
    if ((loyaltyPoints || 0) < pointsCost) {
      toast.error(`رصيد النقاط غير كافٍ لإضافة وحدة أخرى. المتاح: ${loyaltyPoints || 0} نقطة`)
      return
    }
    try {
      const clientTxnId = generateUUID()
      await apiFetch('/loyalty/redeem', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Client-Txn-Id': clientTxnId },
        body: JSON.stringify({
          customerId: cart.customerId,
          points: pointsCost,
          note: `استبدال منتج (وحدة إضافية): ${item.nameAr || item.name}`,
          clientTxnId,
        }),
      })
      cart.updateQuantity(item.productId, item.quantity + 1)
      setCustomer(cart.customerId!, cart.customerName, cart.customerPhone, (loyaltyPoints || 0) - pointsCost)
    } catch (e) {
      notifyError(e, { context: 'استبدال النقاط' })
    }
  }

  // Refund `points` back to the current customer's balance via the atomic
  // /loyalty/refund endpoint, then reflect the new balance locally. Returns
  // true on success so callers can decide whether it's safe to also mutate
  // the cart (see removePointsAwareItem / decrementPointsItem below).
  const refundPoints = async (points: number, note: string) => {
    if (!cart.customerId || points <= 0) return true
    try {
      const clientTxnId = generateUUID()
      await apiFetch('/loyalty/refund', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Client-Txn-Id': clientTxnId },
        body: JSON.stringify({ customerId: cart.customerId, points, note, clientTxnId }),
      })
      setCustomer(cart.customerId, cart.customerName, cart.customerPhone, (loyaltyPoints || 0) + points)
      return true
    } catch (e) {
      notifyError(e, { context: 'استرجاع النقاط' })
      return false
    }
  }

  // Remove a cart line entirely. FIX: deleting a "استبدال بالنقاط" line used
  // to just drop it from the cart with cart.removeItem — the points already
  // deducted when it was added (confirmRedeemProduct/incrementPointsItem)
  // never came back, so cancelling the line before checkout permanently
  // cost the customer points for a product they never received. Now the
  // full points cost of the line (per-unit cost × quantity) is refunded
  // first, then the line is removed either way so the cart never gets stuck
  // on a failed refund call.
  const removePointsAwareItem = async (item: CartItem) => {
    if (item.isPointsItem && item.pointsCost) {
      await refundPoints(
        item.pointsCost * item.quantity,
        `استرجاع نقاط — حذف من السلة: ${item.nameAr || item.name}`
      )
    }
    cart.removeItem(item.productId)
  }

  // "مسح" (clear/cancel the whole current sale) has the exact same bug as a
  // single-line removal: any points-redeemed lines in the cart already had
  // their points deducted, so wiping the cart must refund all of them
  // first, not just drop cart.items and leave the customer's balance short.
  const clearCartRefundingPoints = async () => {
    const pointsItems = cart.items.filter(i => i.isPointsItem && i.pointsCost)
    for (const item of pointsItems) {
      await refundPoints(
        (item.pointsCost || 0) * item.quantity,
        `استرجاع نقاط — إلغاء الفاتورة: ${item.nameAr || item.name}`
      )
    }
    cart.clearCart()
  }

  // Symmetric counterpart to incrementPointsItem for the "-" stepper: refund
  // one unit's worth of points, then either lower the quantity or drop the
  // line if it hits zero. Same underlying bug as removePointsAwareItem —
  // the stepper used to call cart.updateQuantity directly with no refund.
  const decrementPointsItem = async (item: CartItem) => {
    const pointsCost = item.pointsCost || 0
    const ok = await refundPoints(
      pointsCost,
      `استرجاع نقاط — تقليل الكمية: ${item.nameAr || item.name}`
    )
    if (!ok) return
    if (item.quantity - 1 <= 0) {
      cart.removeItem(item.productId)
    } else {
      cart.updateQuantity(item.productId, item.quantity - 1)
    }
  }

  const filteredProducts = products.filter(p => {
    const matchCat = activeCategory === 'all' || p.categoryId === activeCategory
    const matchSearch = !search ||
      p.name?.toLowerCase().includes(search.toLowerCase()) ||
      p.nameAr?.includes(search) ||
      p.barcode?.includes(search) ||
      p.sku?.toLowerCase().includes(search.toLowerCase())
    return matchCat && matchSearch && p.active
  })

  const totalProductPages = Math.max(1, Math.ceil(filteredProducts.length / productPageSize))
  const safeProductPage = Math.min(productPage, totalProductPages - 1)
  const pagedProducts = filteredProducts.slice(
    safeProductPage * productPageSize,
    (safeProductPage + 1) * productPageSize,
  )

  useEffect(() => {
    setProductPage(0)
  }, [search, activeCategory, productPageSize])

  // ============================================================
  // CALCULATIONS — single source of truth (no duplication)
  // ============================================================
  // Fix: percent discount was treated as fixed EGP amount.
  // Now: if discountType === 'PERCENT', discount = subtotal * amount / 100
  //       if discountType === 'FIXED', discount = amount (clamped to subtotal)
  // ============================================================
  const calcTotals = useCallback(() => {
    const subtotal = cart.items.reduce((s, i) => s + i.price * i.quantity, 0)
    // FIX: this used to check ONLY cart.taxExempt (the per-invoice toggle),
    // never taxEnabled (the global Settings → الضرائب switch). taxExempt
    // resets to false on every clearCart()/new sale, but taxEnabled stays
    // off — so after the very first sale, new invoices kept charging tax
    // while the UI still showed "موقوفة من الإعدادات" (it reads taxEnabled
    // for the badge, but the actual math read taxExempt). Now the global
    // switch is checked directly here too, so the number always matches
    // what the badge says regardless of per-invoice toggle state.
    const effectiveTaxExempt = !taxEnabled || cart.taxExempt
    const taxAmount = effectiveTaxExempt
      ? 0
      : cart.items.reduce((s, i) => s + (i.price * i.quantity * i.taxRate / 100), 0)
    // EGP-per-point comes from Settings → الولاء (loyalty.egpPerPoint), not
    // a hardcoded 0.05 — so changing it there now actually changes what a
    // redeemed point is worth on the next sale.
    const loyaltyDiscount = cart.loyaltyRedeem * loyaltySettings.egpPerPoint

    // Fix: apply discount type correctly
    let discountAmount = 0
    if (cart.discountType === 'PERCENT') {
      discountAmount = subtotal * (cart.discountAmount || 0) / 100
    } else {
      discountAmount = cart.discountAmount || 0
    }
    // Clamp: discount cannot exceed subtotal (+ tax is not discounted)
    discountAmount = Math.min(discountAmount, subtotal)

    const totalDiscount = discountAmount + loyaltyDiscount
    const total = Math.max(0, subtotal + taxAmount - totalDiscount)

    return { subtotal, taxAmount, discountAmount, loyaltyDiscount, totalDiscount, total }
  }, [cart.items, cart.discountAmount, cart.discountType, cart.loyaltyRedeem, cart.taxExempt, taxEnabled, loyaltySettings.egpPerPoint])

  const { subtotal, taxAmount, totalDiscount, total } = calcTotals()

  const handleHold = () => {
    if (cart.items.length === 0) { toast.error('السلة فارغة'); return }
    cart.holdSale()
    toast.success('تم تعليق الفاتورة')
  }

  const handleCompleteSale = async (paymentData: PaymentPayload) => {
    // Use the SAME calcTotals — no duplication, no drift
    const { subtotal, taxAmount, totalDiscount, total } = calcTotals()

    // Build sale object with items (for receipt)
    const saleData = {
      invoiceNumber: `INV-${Date.now()}`,
      customerId: cart.customerId,
      customer: cart.customerName ? { name: cart.customerName } : null,
      user: { name: user?.name || 'المستخدم' },
      items: cart.items.map(i => ({
        product: { nameAr: i.nameAr, name: i.name },
        quantity: i.quantity,
        unitPrice: i.price,
        total: i.price * i.quantity,
      })),
      subtotal,
      discountAmount: totalDiscount,
      taxAmount,
      total,
      paidAmount: paymentData.paid || total,
      changeAmount: Math.max(0, (paymentData.paid || total) - total),
      paymentMethod: paymentData.method,
      loyaltyEarned: cart.customerId ? Math.floor(total / 10) : 0,
      createdAt: new Date().toISOString(),
    }

    // Generate a stable clientTxnId BEFORE the network call so that
    // retries (network failures, timeouts) hit the server's idempotency
    // cache (X-Client-Txn-Id header lookup) and return the original sale
    // instead of creating a duplicate. Also threaded into the body so the
    // desktop SQLite handler (handleCreateSale) propagates the same id to
    // stock_movements / loyalty_transactions / cash_movements / sync_queue.
    const clientTxnId = generateUUID()

    try {
      // apiFetch routes to SQLite in desktop, API in web
      const sale = await apiFetch('/sales', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Client-Txn-Id': clientTxnId,
        },
        body: JSON.stringify({
          // FIX: pointsRedeemed was never sent, so the API (which prices
          // "pointsRedeemed" lines at 0 and prices everything else at the
          // product's real sellingPrice) always fell into the second case
          // — a points item that was already paid for in points got
          // charged its FULL cash price again on top. Every points line
          // now tells the server it was already settled in points.
          items: cart.items.map(i => ({ productId: i.productId, quantity: i.quantity, pointsRedeemed: !!i.isPointsItem })),
          customerId: cart.customerId,
          userId: user?.id,
          // Send the COMPUTED discount (fixed EGP), not the raw input.
          // The server's handleCreateSale expects a fixed amount.
          discountAmount: totalDiscount,
          discountType: cart.discountType,
          subtotal,
          taxAmount,
          taxExempt: cart.taxExempt,
          total,
          paymentMethod: paymentData.method,
          paymentDetails: paymentData.details,
          paidAmount: paymentData.paid,
          note: cart.note,
          loyaltyRedeem: cart.loyaltyRedeem,
          clientTxnId,
        })
      })
      // The server persists each SaleItem against the real product record
      // (product.nameAr), so the "(بالنقاط)" tag added client-side above
      // gets lost the moment we display sale.items instead of
      // saleData.items — the printed receipt would show a plain product
      // at ٠ ج.م with no indication it was a points redemption. Re-apply
      // the tag by matching back against the cart lines we just sent.
      const pointsProductIds = new Set(cart.items.filter(i => i.isPointsItem).map(i => i.productId))
      const taggedItems = (sale.items || saleData.items || []).map((it) => {
        if (!pointsProductIds.has(it.productId) && !pointsProductIds.has(it.product?.id)) return it
        const baseName = it.product?.nameAr || it.product?.name || ''
        if (baseName.includes('(بالنقاط)')) return it
        return { ...it, product: { ...it.product, nameAr: `${baseName} (بالنقاط)` } }
      })
      setLastSale({ ...saleData, ...sale, items: taggedItems })
      cart.clearCart()
      setPaymentOpen(false)
      toast.success(`تمت الفاتورة: ${sale.invoiceNumber}`)
      loadData()
      checkRegisterStatus()
    } catch (e) {
      notifyError(e, { context: 'إتمام عملية البيع' })
    }
  }

  return (
    <div className="pos-workspace flex flex-col md:flex-row h-screen">
      {/* LEFT: Products */}
      <div className="flex-1 flex flex-col min-w-0 p-3 md:p-4 gap-3 min-h-0">
        {/* Search & barcode */}
        <div className="pos-toolbar flex items-center gap-2.5">
          <div className="relative flex-1">
            <ScanLine className="absolute right-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-primary pointer-events-none" />
            <Input
              ref={searchRef}
              placeholder="امسح الباركود أو ابحث عن منتج... (F2)"
              className="pr-11 pl-20 h-12 text-sm md:text-base rounded-2xl bg-card shadow-sm border-border/80 focus-visible:ring-2 focus-visible:ring-primary/40 transition-all"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && search) {
                  handleBarcode(search)
                  setSearch('')
                }
              }}
            />
            <div className="absolute left-2.5 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
              {search && (
                <button
                  type="button"
                  onClick={() => setSearch('')}
                  className="p-1 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-colors"
                  title="مسح البحث"
                >
                  <X className="w-4 h-4" />
                </button>
              )}
              <kbd className="hidden sm:inline-flex items-center px-2 py-0.5 text-[10px] font-semibold text-muted-foreground bg-muted rounded-md border border-border/60">
                F2
              </kbd>
            </div>
          </div>
          <Button
            variant="outline"
            size="lg"
            className="h-12 px-4 rounded-2xl shadow-sm border-border/80 bg-card hover:border-primary/50 hover:bg-primary/5 gap-2 transition-all"
            onClick={() => setHeldOpen(true)}
          >
            <Pause className="w-4 h-4 text-amber-500" />
            <span className="text-xs font-semibold">المعلقة</span>
            {cart.heldSales.length > 0 && (
              <Badge variant="secondary" className="px-1.5 py-0 text-[11px] font-bold bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                {cart.heldSales.length}
              </Badge>
            )}
          </Button>
        </div>

        {/* Categories — horizontal snap row with edge navigation arrows */}
        <div className="pos-cat-wrap">
          {!catScroll.start && (
            <button
              type="button"
              className="pos-cat-nav-btn side-start shadow-sm"
              onClick={() => scrollCats('prev')}
              aria-label="رجوع لبداية الفئات"
            >
              <ChevronRight className="w-4 h-4" />
            </button>
          )}
          {!catScroll.end && (
            <button
              type="button"
              className="pos-cat-nav-btn side-end shadow-sm"
              onClick={() => scrollCats('next')}
              aria-label="فئات أكثر"
            >
              <ChevronLeft className="w-4 h-4" />
            </button>
          )}
          <div
            ref={catRowRef}
            className="pos-categories-scroll no-visible-scrollbar"
            onScroll={updateCatScroll}
          >
            <div className="pos-cat-row py-1">
              <button
                type="button"
                className={cn(
                  "pos-cat-pill transition-all duration-200 font-medium",
                  activeCategory === 'all' && "shadow-sm scale-[1.02]"

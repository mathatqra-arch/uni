          </div>
          {totalProductPages > 1 && (
            <div className="pos-products-pagination" aria-label="تنقل المنتجات">
              <span className="text-xs text-muted-foreground pos-number">
                صفحة {safeProductPage + 1} من {totalProductPages}
              </span>
              <div className="flex items-center gap-1">
                <Button
                  type="button"
                  variant="outline"
                  size="icon"
                  className="h-9 w-9"
                  aria-label="الصفحة التالية"
                  disabled={safeProductPage >= totalProductPages - 1}
                  onClick={() => setProductPage(page => Math.min(totalProductPages - 1, page + 1))}
                >
                  <ChevronLeft className="w-4 h-4" />
                </Button>
                <Button
                  type="button"
                  variant="outline"
                  size="icon"
                  className="h-9 w-9"
                  aria-label="الصفحة السابقة"
                  disabled={safeProductPage <= 0}
                  onClick={() => setProductPage(page => Math.max(0, page - 1))}
                >
                  <ChevronLeft className="w-4 h-4 rotate-180" />
                </Button>
              </div>
            </div>
          )}
          {filteredProducts.length === 0 && !loading && (
            <div className="text-center py-20 text-muted-foreground">
              <Search className="w-12 h-12 mx-auto mb-3 opacity-30" />
              <p>لا توجد منتجات</p>
            </div>
          )}
        </div>
      </div>

      {/* RIGHT: Cart — branded with purple/teal gradient accents
          Desktop (md+): fixed 420px side panel
          Mobile (<md): hidden, replaced by floating button + Sheet drawer */}
      <div className="hidden md:flex w-[420px] shrink-0 border-r border-border/80 bg-card flex-col shadow-[0_0_30px_-24px_rgba(22,0,41,.45)]">
        {/* Cart header — gradient accent */}
        <div className="bg-brand-gradient p-4 text-primary-foreground">
          <div className="flex items-center justify-between mb-3">
            <div className="flex items-center gap-2">
              <div className="w-8 h-8 rounded-lg bg-primary-foreground/15 flex items-center justify-center">
                <ShoppingCart className="w-4 h-4 text-primary-foreground" />
              </div>
              <h2 className="font-bold text-base md:text-lg">الفاتورة الحالية</h2>
              {cart.items.length > 0 && (
                <Badge className="bg-primary-foreground/20 text-primary-foreground hover:bg-primary-foreground/30 border-0 text-xs px-2 py-0.5 font-bold">
                  {cart.items.reduce((sum, item) => sum + item.quantity, 0)} قطعة
                </Badge>
              )}
            </div>
            {cart.items.length > 0 && (
              <Button
                variant="ghost"
                size="sm"
                onClick={() => clearCartRefundingPoints()}
                className="text-primary-foreground/90 hover:text-white hover:bg-red-500/30 h-8 px-2.5 rounded-lg text-xs gap-1 transition-colors"
                title="إفراغ السلة بالكامل"
              >
                <Trash2 className="w-3.5 h-3.5" />
                مسح
              </Button>
            )}
          </div>

          {/* Customer button */}
          <div className="relative">
            <Button
              variant={cart.customerId ? 'secondary' : 'outline'}
              className={cn(
                "w-full justify-start h-11 rounded-xl text-xs sm:text-sm font-medium transition-all",
                cart.customerId
                  ? "bg-background text-foreground hover:bg-background/90 shadow-sm border-0"
                  : "bg-primary-foreground/15 border-primary-foreground/25 text-primary-foreground hover:bg-primary-foreground/25"
              )}
              onClick={() => setCustomerOpen(true)}
            >
              <User className="w-4 h-4 ml-2 shrink-0" />
              {cart.customerName ? (
                <div className="flex items-center justify-between w-full overflow-hidden">
                  <span className="font-bold truncate">{cart.customerName}</span>
                  <Badge className="mr-auto bg-amber-500/20 text-amber-700 dark:text-amber-400 border border-amber-500/30 font-semibold text-[11px] px-2 py-0.5">
                    {cart.loyaltyPoints} نقطة
                  </Badge>
                </div>
              ) : (
                <span className="text-primary-foreground/80">إضافة عميل (اختياري) — F3</span>
              )}
            </Button>
            {cart.customerId && (
              <button
                type="button"
                onClick={(e) => {
                  e.stopPropagation()
                  cart.setCustomer(null, '', 0)
                }}
                className="absolute left-2.5 top-1/2 -translate-y-1/2 p-1 rounded-full text-muted-foreground hover:text-destructive hover:bg-muted transition-colors"
                title="إزالة العميل"
              >
                <X className="w-3.5 h-3.5" />
              </button>
            )}
          </div>

          {/* Loyalty redemption */}
          {loyaltySettings.enabled && cart.customerId && cart.loyaltyPoints > 0 && (
            <div className="mt-2.5 pt-2.5 border-t border-primary-foreground/20">
              <LoyaltyRedeemControl
                availablePoints={cart.loyaltyPoints}
                redeemPoints={cart.loyaltyRedeem}
                minRedeem={loyaltySettings.minRedeem}
                egpPerPoint={loyaltySettings.egpPerPoint}
                onChange={setLoyaltyRedeem}
              />
            </div>
          )}
        </div>

        {/* Cart items */}
        <ScrollArea className="flex-1 min-h-0 bg-muted/10">
          <div className="p-3 space-y-2">
            {cart.items.length === 0 ? (
              <div className="text-center py-16 px-4 text-muted-foreground">
                <div className="w-16 h-16 rounded-full bg-muted/60 flex items-center justify-center mx-auto mb-3 text-muted-foreground/60">
                  <ShoppingCart className="w-8 h-8" />
                </div>
                <p className="font-semibold text-foreground text-sm">السلة فارغة</p>
                <p className="text-xs text-muted-foreground mt-1">اختر المنتجات أو امسح الباركود لإضافتها إلى الفاتورة</p>
              </div>
            ) : (
              cart.items.map(item => (
                <div
                  key={item.productId}
                  className="bg-card rounded-xl p-3 border border-border/70 hover:border-primary/40 shadow-xs transition-all duration-150"
                >
                  <div className="flex items-start justify-between gap-2 mb-2">
                    <div className="flex-1 min-w-0">
                      <p className="text-sm font-bold truncate text-foreground">
                        {item.nameAr || item.name}
                      </p>
                      <div className="flex items-center gap-1.5 text-xs text-muted-foreground pos-number mt-0.5">
                        <span className="font-medium text-foreground/80">{formatEGP(item.price)}</span>
                        <span>×</span>
                        <span>{item.quantity}</span>
                      </div>
                    </div>
                    <Button
                      variant="ghost"
                      size="icon"
                      className="h-7 w-7 shrink-0 text-muted-foreground hover:text-destructive hover:bg-destructive/10 rounded-lg transition-colors"
                      onClick={() => removePointsAwareItem(item)}
                      title="حذف من الفاتورة"
                    >
                      <X className="w-4 h-4" />
                    </Button>
                  </div>

                  <div className="flex items-center justify-between gap-2 pt-1 border-t border-border/40">
                    <div className="flex items-center bg-muted/60 rounded-lg border border-border/80 p-0.5">
                      <Button
                        variant="ghost"
                        size="icon"
                        className="h-7 w-7 rounded-md hover:bg-background hover:text-primary transition-all"
                        onClick={() => item.isPointsItem ? decrementPointsItem(item) : cart.updateQuantity(item.productId, item.quantity - 1)}
                      >
                        <Minus className="w-3.5 h-3.5" />
                      </Button>
                      <Input
                        className="h-7 w-11 text-center pos-number border-0 px-0 font-bold bg-transparent shadow-none focus-visible:ring-0 text-xs sm:text-sm"
                        value={item.quantity}
                        readOnly={!!item.isPointsItem}
                        onChange={(e) => {
                          if (item.isPointsItem) return
                          const qty = parseInt(e.target.value) || 0
                          cart.updateQuantity(item.productId, qty)
                        }}
                      />
                      <Button
                        variant="ghost"
                        size="icon"
                        className="h-7 w-7 rounded-md hover:bg-background hover:text-primary transition-all"
                        disabled={item.isPointsItem && (loyaltyPoints || 0) < (item.pointsCost || 0)}
                        title={item.isPointsItem ? `تضيف وحدة أخرى مقابل ${item.pointsCost} نقطة` : undefined}
                        onClick={() => item.isPointsItem ? incrementPointsItem(item) : cart.updateQuantity(item.productId, item.quantity + 1)}
                      >
                        <Plus className="w-3.5 h-3.5" />
                      </Button>
                    </div>
                    <span className="text-sm font-extrabold pos-number text-primary">
                      {item.isPointsItem ? `${(item.pointsCost || 0) * item.quantity} نقطة` : formatEGP(item.price * item.quantity)}
                    </span>
                  </div>
                </div>
              ))
            )}
          </div>
        </ScrollArea>

        {/* Summary & actions — branded */}
        <div className="pos-cart-footer border-t border-border/80 bg-background/95 p-4 space-y-3.5 shrink-0 shadow-lg">
          <div className="space-y-2 text-sm bg-muted/20 p-3 rounded-xl border border-border/60">
            <div className="flex justify-between text-muted-foreground text-xs sm:text-sm">
              <span>المجموع الفرعي</span>
              <span className="pos-number font-semibold text-foreground">{formatEGP(subtotal)}</span>
            </div>
            <div className="flex justify-between items-center text-muted-foreground text-xs sm:text-sm">
              <button
                type="button"
                disabled={!taxEnabled}
                onClick={() => taxEnabled && setTaxExempt(!cart.taxExempt)}
                className={cn(
                  "flex items-center gap-1.5 rounded transition-colors",
                  cart.taxExempt ? "text-destructive font-medium" : "hover:text-foreground",
                  !taxEnabled && "cursor-default"
                )}
                title={!taxEnabled ? "الضريبة موقوفة من الإعدادات لكل الفواتير" : cart.taxExempt ? "الضريبة معطّلة لهذه الفاتورة — اضغط للتفعيل" : "اضغط لتعطيل الضريبة على هذه الفاتورة"}
              >
                <span>الضريبة (14%)</span>
                {!taxEnabled ? (
                  <Badge variant="secondary" className="text-[9px] px-1 py-0 h-4">موقوفة</Badge>
                ) : cart.taxExempt && (
                  <Badge variant="destructive" className="text-[9px] px-1.5 py-0 h-4 font-bold">معطّلة</Badge>
                )}
              </button>
              <span className={cn("pos-number font-semibold", cart.taxExempt && "line-through text-destructive")}>{formatEGP(taxAmount)}</span>
            </div>
            {totalDiscount > 0 && (
              <div className="flex justify-between text-emerald-600 dark:text-emerald-400 font-semibold text-xs sm:text-sm">
                <span>
                  الخصم
                  {cart.discountType === 'PERCENT' && ` (${cart.discountAmount}%)`}
                  {cart.loyaltyRedeem > 0 && ` + ${cart.loyaltyRedeem} نقطة`}
                </span>
                <span className="pos-number">- {formatEGP(totalDiscount)}</span>
              </div>
            )}
            <Separator className="my-1.5" />
            <div className="flex justify-between items-baseline pt-0.5">
              <span className="text-base font-bold text-foreground">الإجمالي المطلوب</span>
              <span className="pos-number text-2xl font-black text-primary tracking-tight">{formatEGP(total)}</span>
            </div>
          </div>

          {/* Quick action buttons — branded icons */}
          <div className="grid grid-cols-4 gap-2">
            <Button
              variant="outline"
              size="sm"
              className="h-12 flex-col text-[10px] gap-0.5 rounded-xl border-border/80 hover:border-primary/50 hover:bg-primary/5 hover:text-primary transition-all"
              onClick={() => setDiscountOpen(true)}
              disabled={cart.items.length === 0}
            >
              <Tag className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
              <span>خصم</span>
              <kbd className="text-[9px] px-1 py-0 bg-muted rounded font-mono text-muted-foreground border">F4</kbd>
            </Button>
            <Button
              variant="outline"

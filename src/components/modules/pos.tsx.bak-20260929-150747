                  onClick={() => setActiveCategory(c.id)}
                  aria-pressed={activeCategory === c.id}
                >
                  {c.nameAr || c.name}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Products grid — min-h-0 keeps this ScrollArea bounded to the
            remaining space instead of growing to fit every product card,
            which is what was pushing the grid past the bottom of the screen. */}
        <div className="pos-products-viewport flex-1 min-h-0">
          <div className="grid grid-cols-[repeat(auto-fill,minmax(132px,1fr))] content-start gap-2 p-1">
            {pagedProducts.map(p => {
              const inCart = cart.items.find(i => i.productId === p.id)
              return (
                <ProductCard
                  key={p.id}
                  product={p}
                  inCartCount={inCart?.quantity || 0}
                  campaignBonus={campaignBonusByProduct[p.id]}
                  pointsRequired={pointsProductsByProduct[p.id]}
                  onAddToCart={addToCart}
                  onRedeemPoints={setRedeemProductTarget}

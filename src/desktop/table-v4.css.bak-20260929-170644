/* ============================================================
   DataTable v4 - FINAL LAYER (wins over v2/v2.2/v3/v2.3)
   Balanced columns + stable borders + tidy scrollbars +
   breathing space at the bottom of every page.
   ============================================================ */

/* --- 1. Balanced columns: fixed layout distributes evenly --- */
.uk-dt-scroll .uk-dt-table,
.uk-dt-scroll .uk-dt-single {
  table-layout: fixed !important;
  width: 100% !important;
}

/* Long content clips gracefully instead of stretching one column */
.uk-dt-scroll .uk-dt-td,
.uk-dt-scroll .uk-dt-th {
  overflow: hidden;
  text-overflow: ellipsis;
}

/* --- 2. Stable, consistent borders --- */
/* vertical separators between every column (RTL-aware) */
.uk-dt-scroll .uk-dt-th,
.uk-dt-scroll .uk-dt-td {
  border-inline-start: 1px solid color-mix(in srgb, var(--border) 42%, transparent);
}
.uk-dt-scroll .uk-dt-th:first-child,
.uk-dt-scroll .uk-dt-td:first-child {
  border-inline-start: 0;
}
/* horizontal row guides (body only - header keeps its strong brand line) */
.uk-dt-scroll .uk-dt-td {
  border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
}
/* clean bottom edge of the frame */
.uk-dt-scroll tbody tr:last-child .uk-dt-td {
  border-bottom: 0;
}

/* --- 3. Tidy scrollbars (tables) --- */
.uk-dt-scroll {
  scrollbar-width: thin;
  scrollbar-color: color-mix(in srgb, var(--foreground) 20%, transparent) transparent;
  scrollbar-gutter: stable;
}
.uk-dt-scroll::-webkit-scrollbar {
  width: 11px;
  height: 11px;
}
.uk-dt-scroll::-webkit-scrollbar-track {
  background: transparent;
}
.uk-dt-scroll::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--foreground) 18%, transparent);
  border-radius: 999px;
  border: 3px solid transparent;
  background-clip: padding-box;
}
.uk-dt-scroll::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--foreground) 34%, transparent);
  background-clip: padding-box;
}
.uk-dt-scroll::-webkit-scrollbar-corner {
  background: transparent;
}
.dark .uk-dt-scroll::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--foreground) 26%, transparent);
  background-clip: padding-box;
}
.dark .uk-dt-scroll::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--foreground) 42%, transparent);
  background-clip: padding-box;
}

/* --- 4. Breathing space at the bottom of every page --- */
.module-page,
.uk-page {
  padding-bottom: clamp(3.5rem, 8vh, 6.5rem) !important;
}

/* --- 4b. Page-level breathing room: main surface + module pages --- */
/* The scroll region wraps every module; give it a soft floor of empty
   space after the last element so pages never feel cut off. */
.uk-scroll-region::after {
  content: "" ;
  display: block;
  height: clamp(3rem, 7vh, 5.5rem);
  flex: 0 0 auto;
}
.uk-scroll-region > .module-page:last-child,
.uk-scroll-region > .uk-page:last-child {
  padding-bottom: clamp(2.5rem, 6vh, 4.5rem) !important;
  margin-bottom: 0 !important;
}
/* Tables keep their own bottom margin; trim it slightly when page padding already breathes */
.module-page .uk-dt,
.uk-page .uk-dt {
  margin-bottom: 0 !important;
}

/* ============================================================
   DataTable v4.1 - horizontal scroll layer
   Balanced columns stay, but a wide table now scrolls
   horizontally instead of squeezing its columns.
   ============================================================ */
.uk-dt-scroll .uk-dt-table,
.uk-dt-scroll .uk-dt-single {
  /* below this width the table overflows and h-scroll appears;
     each module can override via --uk-dt-min */
  min-width: var(--uk-dt-min, 920px);
}

/* make the horizontal bar easy to discover and grab */
.uk-dt-scroll::-webkit-scrollbar:horizontal {
  height: 13px;
}
.uk-dt-scroll::-webkit-scrollbar-track:horizontal {
  background: color-mix(in srgb, var(--foreground) 5%, transparent);
  border-radius: 999px;
  margin: 0 6px;
}
.uk-dt-scroll::-webkit-scrollbar-thumb:horizontal {
  background: color-mix(in srgb, var(--foreground) 24%, transparent);
  border-radius: 999px;
  border: 3px solid transparent;
  background-clip: padding-box;
}
.uk-dt-scroll::-webkit-scrollbar-thumb:horizontal:hover {
  background: color-mix(in srgb, var(--foreground) 40%, transparent);
  background-clip: padding-box;
}
.dark .uk-dt-scroll::-webkit-scrollbar-track:horizontal {
  background: color-mix(in srgb, var(--foreground) 8%, transparent);
}
.dark .uk-dt-scroll::-webkit-scrollbar-thumb:horizontal {
  background: color-mix(in srgb, var(--foreground) 32%, transparent);
  background-clip: padding-box;
}

/* ============================================================
   Responsive table polish
   Tables are intentionally dense enough for cashier workflows, while
   preserving comfortable reading and touch targets on smaller windows.
   This is visual-only and keeps all data processing strictly local.
   ============================================================ */
.uk-dt {
  border-color: color-mix(in srgb, var(--border) 52%, transparent);
}

.uk-dt-scroll,
.uk-table-container {
  -webkit-overflow-scrolling: touch;
  scroll-padding-inline: 1rem;
}

.uk-dt-scroll .uk-dt-table {
  min-width: var(--uk-dt-min, 720px);
}

/* A single physical table keeps the header and body column geometry identical.
   The data area owns vertical scrolling; the companion bar remains visible at
   the bottom of the card and drives horizontal scrolling in both directions. */
.uk-dt-scroll .uk-table-container {
  overflow: visible !important;
  min-width: 0;
}

.uk-dt-scroll .uk-dt-table {
  width: 100% !important;
  table-layout: fixed !important;
  border-collapse: separate !important;
  border-spacing: 0 !important;
}

.uk-dt-scroll .uk-dt-th,
.uk-dt-scroll .uk-dt-td {
  overflow: hidden;
  text-overflow: ellipsis;
}

.uk-dt-scroll .uk-dt-th {
  position: sticky !important;
  top: 0 !important;
  z-index: 20 !important;
}

.uk-dt-bottom-scroll {
  flex: 0 0 15px;
  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  direction: ltr;
  border-top: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  background: color-mix(in srgb, var(--card) 94%, var(--muted));
  scrollbar-gutter: stable;
  overscroll-behavior-inline: contain;
}

.uk-dt-bottom-scroll::-webkit-scrollbar { height: 13px; }
.uk-dt-bottom-scroll::-webkit-scrollbar-track {
  background: color-mix(in srgb, var(--foreground) 6%, transparent);
  border-radius: 999px;
}
.uk-dt-bottom-scroll::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--foreground) 28%, transparent);
  border-radius: 999px;
  border: 3px solid transparent;
  background-clip: padding-box;
}
.uk-dt-bottom-scroll::-webkit-scrollbar-thumb:hover {
  background: color-mix(in srgb, var(--foreground) 45%, transparent);
  background-clip: padding-box;
}

.uk-dt-row-action:focus-visible {
  position: relative;
  z-index: 2;
  outline: 2px solid var(--ring);
  outline-offset: -2px;
  background: color-mix(in srgb, var(--secondary) 38%, var(--card)) !important;
}

@media (max-width: 767px) {
  .uk-dt {
    border-radius: 1rem;
    margin-bottom: 1rem;
  }

  .uk-dt-scroll .uk-dt-th,
  .uk-dt-scroll .uk-dt-td {
    padding-inline: .75rem !important;
  }

  .uk-dt-scroll .uk-dt-th {
    min-height: 2.75rem;
    font-size: .72rem !important;
  }

  .uk-dt-scroll .uk-dt-td {
    padding-block: .7rem !important;
    font-size: .82rem;
  }

  .uk-table-container > table:not(.uk-dt-table) th,
  .uk-table-container > table:not(.uk-dt-table) td {
    padding-inline: .75rem !important;
  }

  .uk-dt-bottom-scroll { flex-basis: 13px; }
}

@media (max-width: 480px) {
  .uk-dt-scroll::-webkit-scrollbar:horizontal {
    height: 10px;
  }
}

/* ============================================================
   DataTable rebuild — isolated from the legacy .uk-dt styles.
   One physical table guarantees header/body alignment; only the viewport
   scrolls vertically and the dedicated bar below controls horizontal scroll.
   ============================================================ */
.uk-grid-table-card {
  border-color: color-mix(in srgb, var(--border) 48%, transparent);
}
.uk-grid-table-viewport {
  overflow: auto;
  overscroll-behavior: contain;
  scrollbar-width: none;
  scrollbar-gutter: stable;
}
.uk-grid-table-viewport::-webkit-scrollbar { display: none; }
.uk-grid-table {
  width: 100%;
  /* Native auto layout gives each column the space its real data needs. */
  table-layout: auto;
  border-collapse: separate;
  border-spacing: 0;
}
.uk-grid-table-head {
  position: sticky;
  top: 0;
  z-index: 4;
  background: linear-gradient(180deg, #f8f0e4, #f3e9d8);
  color: #772344;
  border-bottom: 2px solid #772344;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .015em;
  white-space: nowrap;
  padding-inline: .85rem !important;
}
.uk-grid-table-cell {
  vertical-align: middle;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 42%, transparent);
  max-width: 22rem;
  overflow-wrap: anywhere;
  white-space: normal;
  line-height: 1.55;
  padding-inline: .85rem !important;
}
.uk-grid-table tbody tr:last-child .uk-grid-table-cell { border-bottom: 0; }
.uk-grid-table tbody tr { transition: background-color 150ms ease; }
.uk-grid-table tbody tr:hover { background: color-mix(in srgb, var(--secondary) 22%, transparent); }
.uk-grid-table-row-action:focus-visible {
  position: relative;
  z-index: 2;
  outline: 2px solid var(--ring);
  outline-offset: -2px;
  background: color-mix(in srgb, var(--secondary) 36%, var(--card));
}
.uk-grid-table-bottom-scroll {
  flex: 0 0 16px;
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-inline: contain;
  border-top: 1px solid color-mix(in srgb, var(--border) 42%, transparent);
  background: color-mix(in srgb, var(--card) 94%, var(--muted));
  scrollbar-gutter: stable;
}
.uk-grid-table-bottom-scroll::-webkit-scrollbar { height: 14px; }
.uk-grid-table-bottom-scroll::-webkit-scrollbar-track { background: color-mix(in srgb, var(--foreground) 6%, transparent); }
.uk-grid-table-bottom-scroll::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--foreground) 30%, transparent);
  border: 3px solid transparent;
  border-radius: 999px;
  background-clip: padding-box;
}
.uk-grid-table-bottom-scroll::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--foreground) 46%, transparent); background-clip: padding-box; }
.dark .uk-grid-table-head { background: linear-gradient(180deg, #321b3d, #2a1533); color: #E8E5A4; border-bottom-color: #E8E5A4; }

@media (max-width: 767px) {
  .uk-grid-table-card { border-radius: 1rem; margin-bottom: 1rem; }
  .uk-grid-table-head, .uk-grid-table-cell { padding-inline: .75rem !important; }
  .uk-grid-table-head { font-size: .72rem; }
  .uk-grid-table-cell { font-size: .82rem; }
}

/* ============================================================
   Shared page/table rhythm
   These rules also cover the simple tables used by reports, cash, audit,
   and dialogs, not just the rebuilt DataTable above.
   ============================================================ */
.uk-table-container [data-slot='table'] {
  width: 100%;
  min-width: 100%;
  table-layout: auto;
  border-collapse: separate;
  border-spacing: 0;
}
.uk-table-container [data-slot='table'] th,
.uk-table-container [data-slot='table'] td {
  max-width: 22rem;
  padding-inline: .85rem !important;
  overflow-wrap: anywhere;
  white-space: normal !important;
  line-height: 1.55;
}
.uk-table-container [data-slot='table'] th { white-space: nowrap !important; }

/* Direct tables used by categories, purchases, suppliers, and reports. */
.uk-shared-table-viewport {
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scrollbar-width: none;
}
.uk-shared-table-viewport::-webkit-scrollbar { display: none; }
.uk-shared-table-bottom-scroll {
  flex: 0 0 15px;
  overflow-x: auto;
  overflow-y: hidden;
  border-top: 1px solid color-mix(in srgb, var(--border) 42%, transparent);
  background: color-mix(in srgb, var(--card) 94%, var(--muted));
  scrollbar-gutter: stable;
}
.uk-shared-table-bottom-scroll::-webkit-scrollbar { height: 13px; }
.uk-shared-table-bottom-scroll::-webkit-scrollbar-track { background: color-mix(in srgb, var(--foreground) 6%, transparent); }
.uk-shared-table-bottom-scroll::-webkit-scrollbar-thumb {
  background: color-mix(in srgb, var(--foreground) 30%, transparent);
  border: 3px solid transparent;
  border-radius: 999px;
  background-clip: padding-box;
}
.uk-shared-table-bottom-scroll::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--foreground) 46%, transparent); background-clip: padding-box; }

/* Tables are work surfaces: keep rows visually still while scanning or scrolling. */
.uk-grid-table-card,
.uk-grid-table-card *,
.uk-shared-table,
.uk-shared-table [data-slot='table'] tr,
.uk-shared-table [data-slot='table'] th,
.uk-shared-table [data-slot='table'] td {
  animation: none !important;
}
.uk-grid-table tbody tr,
.uk-grid-table-row-action,
.uk-shared-table [data-slot='table'] tr {
  transform: none !important;
  transition: none !important;
}

/* A consistent, calm landing area after the final control on every module. */
.uk-scroll-region > .module-page,
.uk-scroll-region > .uk-page,
.uk-scroll-region > .uk-module-page {
  padding-bottom: clamp(5.5rem, 12vh, 9rem) !important;
}
.uk-scroll-region > :last-child {
  margin-bottom: clamp(2rem, 6vh, 4rem);
}


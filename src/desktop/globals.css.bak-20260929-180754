[data-slot="input"]::placeholder { color: var(--uk-text-muted) !important; opacity: .82; }
[data-slot="input"]:hover { border-color: color-mix(in srgb, #772344 48%, var(--uk-border-strong)) !important; }
[data-slot="input"]:focus-visible {
  border-color: #D44D5C !important;
  box-shadow: 0 0 0 3px rgba(212,77,92,.16) !important;
}

[data-slot="select-trigger"] {
  background-color: var(--uk-surface-strong) !important;
  border-color: var(--uk-border-strong) !important;
  color: var(--uk-text-strong) !important;
}
[data-slot="select-content"],
[data-slot="popover-content"],
[data-slot="command"],
[data-slot="command-dialog"],
[data-slot="dropdown-menu-content"] {
  background-color: var(--uk-surface-strong) !important;
  color: var(--uk-text-strong) !important;
  border-color: var(--uk-border-strong) !important;
  box-shadow: 0 24px 65px -24px rgba(22,0,41,.42) !important;

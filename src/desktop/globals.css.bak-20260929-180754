@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/* ============================================================
   Uni Kasher System — Professional Design System
   ============================================================
   Identity:
   • Cream:    #F5EFE2 — app background
   • Soft Yellow: #E8E5A4 — secondary highlight
   • Coral:    #D44D5C — primary action/accent
   • Burgundy: #772344 — primary brand/deep interactive tone
   • Plum:     #160029 — sidebar/strong contrast
   • Sidebar:  plum #160029 with cream text and coral active state
   • Radius: 16-24px (soft, modern, friendly)
   Fonts: Cairo (headlines) + Tajawal (body) + JetBrains Mono (numbers)
   ============================================================ */

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-cairo);
  --font-cairo: var(--font-cairo);
  --font-tajawal: var(--font-tajawal);
  --font-mono: var(--font-jetbrains-mono);
  --color-sidebar-ring: var(--sidebar-ring);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar: var(--sidebar);
  --color-chart-5: var(--chart-5);
  --color-chart-4: var(--chart-4);
  --color-chart-3: var(--chart-3);
  --color-chart-2: var(--chart-2);
  --color-chart-1: var(--chart-1);
  --color-ring: var(--ring);
  --color-input: var(--input);
  --color-border: var(--border);
  --color-destructive: var(--destructive);
  --color-accent-foreground: var(--accent-foreground);
  --color-accent: var(--accent);
  --color-muted-foreground: var(--muted-foreground);
  --color-muted: var(--muted);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-secondary: var(--secondary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary: var(--primary);
  --color-popover-foreground: var(--popover-foreground);
  --color-popover: var(--popover);
  --color-card-foreground: var(--card-foreground);
  --color-card: var(--card);
  /* Uni Kasher brand tokens */
  --color-unikasher-bg: var(--unikasher-bg);
  --color-unikasher-accent: var(--unikasher-accent);
  --color-unikasher-dark: var(--unikasher-dark);
  --color-kpi-purple: var(--kpi-purple);
  --color-kpi-green: var(--kpi-green);
  --color-kpi-yellow: var(--kpi-yellow);
  --color-kpi-blue: var(--kpi-blue);
  --color-kpi-pink: var(--kpi-pink);
  --color-kpi-red: var(--kpi-red);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 12px);
}

:root {
  --radius: 0.875rem;

  --font-cairo: 'Cairo', 'Segoe UI', Tahoma, 'Noto Sans Arabic', sans-serif;
  --font-tajawal: 'Tajawal', 'Segoe UI', Tahoma, 'Noto Sans Arabic', sans-serif;
  --font-jetbrains-mono: 'JetBrains Mono', 'Consolas', 'SFMono-Regular', 'Courier New', monospace;

  /* Uni Kasher light brand palette:
     Cream  #F5EFE2 | Soft Yellow #E8E5A4 | Coral #D44D5C
     Burgundy #772344 | Plum #160029 */
  --background: 41.1 48.7% 92.4%;
  --foreground: 272.2 100% 8%;
  --card: 42 38% 98%;
  --card-foreground: 272.2 100% 8%;
  --popover: 42 38% 98%;
  --popover-foreground: 272.2 100% 8%;
  --primary: 336.4 54.5% 30.2%;
  --primary-foreground: 41.1 48.7% 92.4%;
  --accent: 353.3 61.1% 56.7%;
  --accent-foreground: 272.2 100% 8%;
  --secondary: 57.4 59.6% 77.6%;
  --secondary-foreground: 272.2 100% 8%;
  --muted: 41 28% 86%;
  --muted-foreground: 272 18% 32%;
  --destructive: 353.3 61.1% 56.7%;
  --border: 336 25% 42%;
  --input: 41 25% 82%;
  --ring: 353.3 61.1% 56.7%;
  --chart-1: 353.3 61.1% 56.7%;
  --chart-2: 336.4 54.5% 30.2%;
  --chart-3: 57.4 59.6% 48%;
  --chart-4: 272.2 100% 8%;
  --chart-5: 41.1 48.7% 52%;

  --sidebar: 272.2 100% 8%;
  --sidebar-foreground: 41.1 48.7% 92.4%;
  --sidebar-primary: 353.3 61.1% 56.7%;
  --sidebar-primary-foreground: 41.1 48.7% 92.4%;
  --sidebar-accent: 336.4 54.5% 30.2%;
  --sidebar-accent-foreground: 41.1 48.7% 92.4%;
  --sidebar-border: 41.1 48.7% 92.4% / 40%;
  --sidebar-ring: 353.3 61.1% 56.7%;

  /* Backward-compatible semantic token names used by existing components. */
  --unikasher-bg: #F5EFE2;
  --unikasher-accent: #D44D5C;
  --unikasher-dark: #160029;
  --uni-kasher-cream: #F5EFE2;
  --uni-kasher-yellow: #E8E5A4;
  --uni-kasher-red: #D44D5C;
  --uni-kasher-burgundy: #772344;
  --uni-kasher-plum: #160029;

  /* Each KPI color is a distinct hue tuned for >=4.5:1 contrast against its
     matching .kpi-badge-* pastel background (verified with WCAG contrast
     math). Previously green/pink shared one value and blue/red shared
     another, and yellow was only 1.15:1 against its own background
     (effectively invisible) — six semantic names must render as six
     recognizable colors, not four. */
  --kpi-purple: 272.2 100% 8%;
  --kpi-green: 142 60% 26%;
  --kpi-yellow: 40 75% 28%;
  --kpi-blue: 217 62% 30%;
  --kpi-pink: 330 58% 32%;
  --kpi-red: 4 65% 32%;
}

.dark {
  --background: 272.2 100% 8%;
  --foreground: 41.1 48.7% 92.4%;
  --card: 336.4 54.5% 20%;
  --card-foreground: 41.1 48.7% 92.4%;
  --popover: 336.4 54.5% 20%;
  --popover-foreground: 41.1 48.7% 92.4%;
  --primary: 57.4 59.6% 77.6%;
  --primary-foreground: 272.2 100% 8%;
  --secondary: 336.4 54.5% 30.2%;
  --secondary-foreground: 41.1 48.7% 92.4%;
  --muted: 336 30% 24%;
  --muted-foreground: 41 20% 75%;
  --accent: 353.3 61.1% 56.7%;
  --accent-foreground: 272.2 100% 8%;
  --destructive: 353.3 61.1% 56.7%;
  --border: 41.1 48.7% 92.4% / 40%;
  --input: 41.1 48.7% 92.4% / 14%;
  --ring: 353.3 61.1% 56.7%;
  --chart-1: 353.3 61.1% 56.7%;
  --chart-2: 57.4 59.6% 77.6%;
  --chart-3: 336.4 54.5% 44%;
  --chart-4: 41.1 48.7% 92.4%;
  --chart-5: 57.4 59.6% 62%;
  --sidebar: 272.2 100% 8%;
  --sidebar-foreground: 41.1 48.7% 92.4%;
  --sidebar-primary: 353.3 61.1% 56.7%;
  --sidebar-primary-foreground: 41.1 48.7% 92.4%;
  --sidebar-accent: 336.4 54.5% 30.2%;
  --sidebar-accent-foreground: 41.1 48.7% 92.4%;
  --sidebar-border: 41.1 48.7% 92.4% / 10%;
  --sidebar-ring: 353.3 61.1% 56.7%;
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-family: 'Alexandria', 'Cairo', 'Tahoma', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
}

/* ============================================================
   CUSTOM SCROLLBAR — slim, subtle
   ============================================================ */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: oklch(0.8 0.005 240);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--unikasher-accent);
}
.dark ::-webkit-scrollbar-thumb {
  background: oklch(0.35 0.005 260);
}

/* ============================================================
   UNI KASHER CARD — soft shadow, large radius
   ============================================================ */
.unikasher-card {
  background: var(--card);
  border-radius: var(--radius-2xl);  /* 22px */
  box-shadow:
    0 4px 6px -1px rgba(0, 0, 0, 0.03),
    0 2px 4px -2px rgba(0, 0, 0, 0.03);
  border: 1px solid oklch(0.94 0.005 240 / 0.5);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.unikasher-card:hover {
  box-shadow:
    0 10px 15px -3px rgba(0, 0, 0, 0.05),
    0 4px 6px -4px rgba(0, 0, 0, 0.05);
}

/* ============================================================
   KPI BADGE — pastel tint backgrounds
   ============================================================ */
.kpi-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-xl);
  flex-shrink: 0;
}
.kpi-badge-purple { background: oklch(0.95 0.03 300); color: var(--kpi-purple); }
.kpi-badge-green  { background: oklch(0.95 0.03 145); color: var(--kpi-green); }
.kpi-badge-yellow { background: oklch(0.96 0.03 80);  color: var(--kpi-yellow); }
.kpi-badge-blue   { background: oklch(0.95 0.03 255); color: var(--kpi-blue); }
.kpi-badge-pink   { background: oklch(0.95 0.03 350); color: var(--kpi-pink); }
.kpi-badge-red    { background: oklch(0.95 0.03 25);  color: var(--kpi-red); }

/* ============================================================
   KPI TINT CARD — full pastel-background card (reference style):
   the whole card is tinted, with a small white icon chip floating
   on top, instead of a white card with a tiny colored icon square.
   ============================================================ */
.kpi-tint-purple { background: oklch(0.94 0.045 300); color: oklch(0.32 0.09 300); }
.kpi-tint-green  { background: oklch(0.94 0.05 150);  color: oklch(0.32 0.09 150); }
.kpi-tint-yellow { background: oklch(0.95 0.05 90);   color: oklch(0.35 0.09 80); }
.kpi-tint-blue   { background: oklch(0.94 0.04 255);  color: oklch(0.32 0.1 255); }
.kpi-tint-pink   { background: oklch(0.94 0.045 350); color: oklch(0.35 0.09 350); }
.kpi-tint-teal   { background: oklch(0.93 0.045 190); color: oklch(0.32 0.08 190); }
.dark .kpi-tint-purple { background: oklch(0.28 0.05 300); color: oklch(0.88 0.05 300); }
.dark .kpi-tint-green  { background: oklch(0.28 0.055 150); color: oklch(0.88 0.06 150); }
.dark .kpi-tint-yellow { background: oklch(0.3 0.055 90);  color: oklch(0.88 0.06 80); }
.dark .kpi-tint-blue   { background: oklch(0.28 0.045 255); color: oklch(0.88 0.06 255); }
.dark .kpi-tint-pink   { background: oklch(0.28 0.05 350); color: oklch(0.88 0.06 350); }
.dark .kpi-tint-teal   { background: oklch(0.27 0.05 190); color: oklch(0.87 0.05 190); }

/* ============================================================
   POS NUMBER — tabular nums for currency
   ============================================================ */
.pos-number {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-family: var(--font-jetbrains-mono), var(--font-cairo), monospace;
  letter-spacing: -0.01em;
}

/* ============================================================
   RECEIPT PRINT — 80mm thermal
   ============================================================ */
@media print {
  body * { visibility: hidden; }
  .receipt-print, .receipt-print * { visibility: visible; }
  .receipt-print {
    position: absolute;
    right: 0;
    top: 0;
    width: 80mm;
  }
  .no-print { display: none !important; }
}

/* ============================================================
   A4 REPORT PRINT — for printing reports on A4 paper
   ============================================================ */
@media print {
  @page {
    size: A4 portrait;
    margin: 10mm 12mm 12mm 12mm;
  }
  
  body {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    color-adjust: exact !important;
    font-size: 11px !important;
  }
  
  body.printing-a4 * {
    visibility: visible !important;
  }
  
  body.printing-a4 {
    background: white !important;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  
  body.printing-a4 .no-print,
  body.printing-a4 .sticky,
  body.printing-a4 [data-radix-popper-content-wrapper],
  body.printing-a4 button,
  body.printing-a4 svg.lucide {
    display: none !important;
  }
  
  body.printing-a4 [data-report-print-root="true"] {
    position: relative !important;
    width: 100% !important;
    max-width: 190mm !important;
    min-height: 260mm !important;
    padding: 10mm 12mm 12mm !important;
    margin: 0 auto !important;
    background: white !important;
    box-sizing: border-box !important;
  }
  
  body.printing-a4 .unikasher-card {
    box-shadow: none !important;
    border: 1px solid #d1d5db !important;
    border-radius: 6px !important;
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: 6px !important;
    overflow: visible !important;
  }
  
  body.printing-a4 .unikasher-card:hover {
    box-shadow: none !important;
    transform: none !important;
  }
  
  body.printing-a4 .kpi-tint-purple,
  body.printing-a4 .kpi-tint-green,
  body.printing-a4 .kpi-tint-yellow,
  body.printing-a4 .kpi-tint-blue,
  body.printing-a4 .kpi-tint-pink,
  body.printing-a4 .kpi-tint-teal {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    border: 1px solid #d1d5db !important;
    border-radius: 6px !important;
    padding: 6px 10px !important;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  
  body.printing-a4 table {
    font-size: 9px !important;
    width: 100% !important;
    border-collapse: collapse !important;
  }
  
  body.printing-a4 thead {
    display: table-header-group !important;
  }
  
  body.printing-a4 th {
    padding: 5px 6px !important;
    background-color: #f3f4f6 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
    border-bottom: 2px solid #374151 !important;
    font-weight: 700 !important;
    font-size: 9px !important;
    white-space: nowrap;
  }
  
  body.printing-a4 td {
    padding: 4px 6px !important;
    border-bottom: 1px solid #e5e7eb !important;
    font-size: 9px !important;
  }
  
  body.printing-a4 tr:nth-child(even) td {
    background-color: #f9fafb !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  
  body.printing-a4 h1 {
    font-size: 16px !important;
  }
  
  body.printing-a4 .text-lg {
    font-size: 12px !important;
  }
  
  body.printing-a4 .text-xl {
    font-size: 14px !important;
  }
  
  body.printing-a4 .text-2xl {
    font-size: 16px !important;
  }
  
  body.printing-a4 .text-xs {
    font-size: 8px !important;
  }
  
  body.printing-a4 .text-sm {
    font-size: 9px !important;
  }
  
  body.printing-a4 .p-3 {
    padding: 4px !important;
  }
  
  body.printing-a4 .p-4 {
    padding: 6px !important;
  }
  
  body.printing-a4 .p-6 {
    padding: 8px !important;
  }
  
  body.printing-a4 .pb-2 {
    padding-bottom: 2px !important;
  }
  
  body.printing-a4 .mb-3 {
    margin-bottom: 4px !important;
  }
  
  body.printing-a4 .gap-1 {
    gap: 4px !important;
  }
  
  body.printing-a4 .gap-2 {
    gap: 6px !important;
  }
  
  body.printing-a4 .gap-3 {
    gap: 6px !important;
  }
  
  body.printing-a4 .gap-4 {
    gap: 8px !important;
  }
  
  body.printing-a4 .space-y-2 > * + * {
    margin-top: 4px !important;
  }
  
  body.printing-a4 .space-y-3 > * + * {
    margin-top: 6px !important;
  }
  
  body.printing-a4 .space-y-4 > * + * {
    margin-top: 6px !important;
  }
  
  body.printing-a4 .space-y-6 > * + * {
    margin-top: 8px !important;
  }
  
  body.printing-a4 .ScrollArea {
    max-height: none !important;
    overflow: visible !important;
  }
  
  body.printing-a4 [data-radix-scroll-area-viewport] {
    max-height: none !important;
    overflow: visible !important;
  }
  
  body.printing-a4 .pos-number {
    font-variant-numeric: tabular-nums !important;
  }
  
  /* Badge styling for print */
  body.printing-a4 [class*="rounded"],
  body.printing-a4 .badge {
    border: 1px solid #d1d5db !important;
    border-radius: 4px !important;
    padding: 1px 4px !important;
    font-size: 8px !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  
  /* Print header for report */
  .print-report-header {
    display: block !important;
    text-align: center;
    width: 100%;
    max-width: 180mm;
    margin: 0 auto 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid #160029;
    page-break-after: avoid;
  }
  .print-report-header h1 {
    font-size: 18px !important;
    font-weight: 700 !important;
    margin-bottom: 2px;
    color: #160029 !important;
  }
  .print-report-header p {
    font-size: 10px !important;
    color: #772344 !important;
  }
  
  /* Print footer */
  .print-report-footer {
    display: block !important;
    text-align: center;
    width: 100%;
    max-width: 180mm;
    margin: 12px auto 0;
    padding-top: 6px;
    border-top: 1px solid #d1d5db;
    font-size: 9px !important;
    color: #9CA3AF !important;
  }
}

/* ============================================================
   PRODUCT CARD — hover lift
   ============================================================ */
.product-card {
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.2s ease;
  border: 1px solid var(--border);
}
.product-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px -8px rgba(212, 77, 92, 0.20);
  border-color: var(--unikasher-accent);
}

/* ============================================================
   GRADIENTS
   ============================================================ */
.bg-unikasher-gradient {
  background: linear-gradient(135deg, #160029 0%, #772344 100%);
}
.bg-unikasher-accent-gradient {
  background: linear-gradient(135deg, #D44D5C 0%, #E8E5A4 100%);
}
.text-unikasher-gradient {
  background: linear-gradient(135deg, #D44D5C 0%, #E8E5A4 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* ============================================================
   GLASS EFFECT
   ============================================================ */
.glass {
  background: oklch(1 0 0 / 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.dark .glass {
  background: oklch(0.16 0.005 260 / 0.7);
}

/* ============================================================
   BRAND GRADIENTS (used by POS cart header + buttons)
   — Previously referenced but never defined, causing transparent
   cart headers and missing loyalty/discount styling.
   ============================================================ */
.bg-brand-gradient {
  background: linear-gradient(135deg, #160029 0%, #772344 55%, #D44D5C 100%);
}
.bg-brand-gold {
  background: linear-gradient(135deg, #E8E5A4 0%, #F5EFE2 100%);
  color: #160029;
}
.text-brand-teal {
  color: #772344;
}
.dark .text-brand-teal {
  color: #E8E5A4;
}

/* ============================================================
   GLASS PANEL — for POS cart and dashboard cards (modern look)
   ============================================================ */
.glass-panel {
  background: oklch(1 0 0 / 0.65);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
  border: 1px solid oklch(1 0 0 / 0.5);
  box-shadow: 0 8px 32px -8px rgba(15, 23, 42, 0.08);
}
.dark .glass-panel {
  background: oklch(0.16 0.01 260 / 0.65);
  border-color: oklch(1 0 0 / 0.08);
}

/* ============================================================
   KEYBOARD HINT
   ============================================================ */
.kbd {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 1.5rem;
  height: 1.5rem;
  padding: 0 0.4rem;
  font-size: 0.7rem;
  font-weight: 600;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--muted);
  color: var(--muted-foreground);
}

/* ============================================================
   ANIMATIONS
   ============================================================ */
@keyframes slide-in-right {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
.animate-slide-in-right { animation: slide-in-right 0.3s ease-out; }

@keyframes fade-in-up {
  from { transform: translateY(10px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.animate-fade-in-up { animation: fade-in-up 0.3s ease-out; }

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212, 77, 92, 0.40); }
  50% { box-shadow: 0 0 0 8px rgba(212, 77, 92, 0); }
}
.animate-pulse-glow { animation: pulse-glow 2s ease-in-out infinite; }

/* ============================================================
   FOCUS RING
   ============================================================ */
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--unikasher-accent);
  outline-offset: 2px;
}

/* ============================================================
   REDUCED MOTION — respect user preference
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {

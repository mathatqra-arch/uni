[data-sonner-toast] {
  --y: 8px;
  animation: uk-toast-in var(--uk-duration-base) var(--uk-ease-emphasis) both;
}
[data-sonner-toast][data-mounted='false'] {
  animation: uk-toast-out 120ms ease both;
}
@keyframes uk-toast-in {
  from { opacity: 0; transform: translate3d(0, var(--y), 0) scale(.985); }
  to { opacity: 1; transform: translate3d(0,0,0) scale(1); }
}
@keyframes uk-toast-out {
  from { opacity: 1; transform: translate3d(0,0,0) scale(1); }
  to { opacity: 0; transform: translate3d(0, 6px, 0) scale(.985); }
}

/* Radix surfaces */
[data-radix-dialog-content][data-state='open'],
[data-radix-drawer-content][data-state='open'],
[data-radix-sheet-content][data-state='open'],
[data-radix-popover-content][data-state='open'] {
  animation: uk-surface-in var(--uk-duration-slow) var(--uk-ease-emphasis) both;
}
[data-radix-dialog-content][data-state='closed'],
[data-radix-drawer-content][data-state='closed'],
[data-radix-sheet-content][data-state='closed'],
[data-radix-popover-content][data-state='closed'] {
  animation: uk-surface-out 160ms var(--uk-ease-standard) both;
}
@keyframes uk-surface-in {
  from { opacity: 0; transform: translate3d(0, 7px, 0) scale(.985); }
  to { opacity: 1; transform: translate3d(0,0,0) scale(1); }
}
@keyframes uk-surface-out {
  from { opacity: 1; transform: translate3d(0,0,0) scale(1); }
  to { opacity: 0; transform: translate3d(0, 4px, 0) scale(.985); }
}

/* Modal / drawer backdrops fade only; no expensive blur animation. */
[data-radix-dialog-overlay][data-state='open'],
[data-radix-drawer-overlay][data-state='open'] {
  animation: uk-overlay-in 180ms ease both;
}
[data-radix-dialog-overlay][data-state='closed'],
[data-radix-drawer-overlay][data-state='closed'] {
  animation: uk-overlay-out 120ms ease both;
}
@keyframes uk-overlay-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes uk-overlay-out { from { opacity: 1; } to { opacity: 0; } }

/* Loading states: stable shimmer instead of repeated opacity flicker. */
.uk-skeleton-shimmer {
  position: relative;
  overflow: hidden;
  background: color-mix(in srgb, hsl(var(--muted)) 86%, white 14%);
}
.uk-skeleton-shimmer::after {
  content: '';
  position: absolute;
  inset: 0 auto 0 -45%;
  width: 45%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.32), transparent);
  animation: uk-shimmer 1.15s linear infinite;
}
@keyframes uk-shimmer { to { transform: translateX(330%); } }

/* Success confirmation */
.uk-success-pop {
  animation: uk-success-pop 420ms var(--uk-ease-spring) both;
}
@keyframes uk-success-pop {
  0% { opacity: 0; transform: scale(.86); }
  65% { opacity: 1; transform: scale(1.055); }
  100% { opacity: 1; transform: scale(1); }
}

/* Number update: brief emphasis so changing financial values are noticed. */
.uk-number-update {
  animation: uk-number-update 360ms var(--uk-ease-emphasis) both;
}
@keyframes uk-number-update {
  0% { transform: translateY(3px); opacity: .65; }
  55% { transform: translateY(-1px); opacity: 1; }
  100% { transform: translateY(0); opacity: 1; }
}

/* Product/cart additions: entrance only, no continuous motion. */
.uk-item-enter {
  animation: uk-item-enter 220ms var(--uk-ease-emphasis) both;
}
@keyframes uk-item-enter {
  from { opacity: 0; transform: translate3d(0, 5px, 0); }
  to { opacity: 1; transform: translate3d(0,0,0); }
}

/* Stagger utility for short lists/grids. */
.uk-stagger > * { animation: uk-item-enter 220ms var(--uk-ease-emphasis) both; }
.uk-stagger > *:nth-child(1) { animation-delay: 0ms; }
.uk-stagger > *:nth-child(2) { animation-delay: 28ms; }
.uk-stagger > *:nth-child(3) { animation-delay: 56ms; }
.uk-stagger > *:nth-child(4) { animation-delay: 84ms; }
.uk-stagger > *:nth-child(5) { animation-delay: 112ms; }
.uk-stagger > *:nth-child(6) { animation-delay: 140ms; }

/* Prevent motion from becoming costly inside very large tables/grids. */
.uk-motion-light > * { animation: none; }

@media (prefers-reduced-motion: reduce) {
  [data-sonner-toast],
  [data-sonner-toast][data-mounted='false'],
  [data-radix-dialog-content],
  [data-radix-drawer-content],
  [data-radix-sheet-content],
  [data-radix-popover-content],
  [data-radix-dialog-overlay],
  [data-radix-drawer-overlay],
  .uk-skeleton-shimmer::after,
  .uk-success-pop,
  .uk-number-update,
  .uk-item-enter,
  .uk-stagger > * {
    animation: none !important;
  }
  * {
    scroll-behavior: auto !important;
  }
}

/* Radix component hooks use data-slot; these selectors intentionally
   complement Tailwind's built-in animate-in/out utilities rather than
   replacing them. */
[data-slot='dialog-content'][data-state='open'],
[data-slot='sheet-content'][data-state='open'] {
  animation: uk-surface-in var(--uk-duration-slow) var(--uk-ease-emphasis) both;
}
[data-slot='dialog-content'][data-state='closed'],
[data-slot='sheet-content'][data-state='closed'] {
  animation: uk-surface-out 160ms var(--uk-ease-standard) both;
}
[data-slot='dialog-overlay'][data-state='open'],
[data-slot='sheet-overlay'][data-state='open'] {
  animation: uk-overlay-in 180ms ease both;
}
[data-slot='dialog-overlay'][data-state='closed'],
[data-slot='sheet-overlay'][data-state='closed'] {
  animation: uk-overlay-out 120ms ease both;
}
[data-slot='toast'] {
  animation: uk-toast-in var(--uk-duration-base) var(--uk-ease-emphasis) both;
}
[data-slot='toast'][data-state='closed'] {
  animation: uk-toast-out 120ms ease both;
}
@media (prefers-reduced-motion: reduce) {
  [data-slot='dialog-content'], [data-slot='sheet-content'],
  [data-slot='dialog-overlay'], [data-slot='sheet-overlay'],
  [data-slot='toast'] { animation: none !important; }
}

/* ============================================================
   Phase 7 — Accessibility, RTL & Responsive hardening
   ============================================================ */
html,
body,
#root {
  min-height: 100%;
  width: 100%;
}

html {
  direction: rtl;
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;
}

body {
  direction: rtl;
  overflow: hidden;
}

#root {
  isolation: isolate;
}

/* Keep keyboard focus visible and consistent across custom + native controls. */
:where(button, a, input, textarea, select, [role='button'], [role='tab'], [role='menuitem'], [tabindex]):focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

/* Don't show a focus ring twice on controls that already provide a strong ring. */
:where(input, textarea, select):focus-visible {
  outline-offset: -1px;
}

/* Screen-reader-only utility. */
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* Logical spacing helpers for RTL-safe layouts. */
[dir='rtl'] .text-left { text-align: start; }
[dir='rtl'] .text-right { text-align: end; }

/* Prevent accidental horizontal overflow while allowing intentional table/print scrollers. */
.app-main-surface {
  min-width: 0;
  overflow-x: hidden;
  overscroll-behavior: contain;
}

/* Tables stay usable on narrow windows without shrinking every column into unreadable text. */
.table-scroll,
[data-slot='table-container'] {
  max-width: 100%;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scrollbar-gutter: stable;
}

/* Improve dense POS/module controls without changing desktop dimensions aggressively. */
@media (max-width: 767px) {
  body {
    overflow: auto;
  }

  .app-main-surface {
    height: auto;
    min-height: 100dvh;
    overflow-y: visible;
  }

  .module-page {
    padding-inline: 0.875rem !important;
  }

  :where(button, [role='button']) {
    min-height: 2.5rem;
  }

  :where(input, textarea, select) {
    min-height: 2.75rem;
  }

  .module-page .grid {
    min-width: 0;
  }
}

@media (max-width: 420px) {
  .module-page {
    padding-inline: 0.75rem !important;
  }

  .app-context-bar {
    padding-inline: 0.75rem !important;
  }
}

/* Avoid browser zoom quirks around data-entry controls. */
@media (max-width: 767px) {
  input,
  textarea,
  select {
    font-size: 16px;
  }
}

/* Respect OS settings and avoid motion during reduced-motion preferences. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* High-contrast fallback for environments that disable alpha blending. */

/* ============================================================
   SIDEBAR TEXT READABILITY ON DARK BACKGROUND
   The sidebar uses dark plum (#160029) as its base color.
   text-sidebar-foreground maps to a very light gray that washes out.
   Override to use brand cream for readability.
   ============================================================ */
.sidebar-active-indicator,
.sidebar .text-sidebar-foreground,
.sidebar .text-muted-foreground {
  color: var(--unikasher-cream) !important;
}

/* ============================================================
   APP HEIGHT — Fill full viewport height, enable scroll when needed
   ============================================================ */
html, body, #root {
  min-height: 100dvh !important;
  height: 100dvh !important;
}

.app-main-surface {
  min-height: 100dvh !important;
  overflow-y: auto;
}

@media (forced-colors: active) {
  :where(button, a, input, textarea, select, [role='button'], [role='tab'], [role='menuitem']) {
    forced-color-adjust: auto;
  }

  :where(button, a, [role='button'], [role='tab'], [role='menuitem']):focus-visible {
    outline: 2px solid Highlight;
  }
}

/* Better touch interaction on hybrid Windows devices. */
@media (pointer: coarse) {
  :where(button, [role='button'], input[type='checkbox'], input[type='radio'], [role='switch']) {
    touch-action: manipulation;
  }
}

/* ============================================================
   PHASE 8 — VISUAL REGRESSION CONTRACTS
   Stable hooks used by automated visual/interaction checks.
   ============================================================ */
.uk-visual-surface {
  contain: layout paint;
  min-width: 0;
}

.uk-focus-ring:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 3px;
}

@media (max-width: 767px) {
  .uk-visual-surface {
    max-width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .uk-visual-surface,
  .uk-focus-ring {
    scroll-behavior: auto;
  }
}

/* ============================================================
   PHASE 9 — Final Release Polish
   ============================================================ */
.uk-release-state {
  position: relative;
  overflow: hidden;
}
.uk-release-state::before {
  content: '';
  position: absolute;
  inset: 0 0 auto;
  height: 4px;
  background: linear-gradient(90deg, var(--uni-kasher-red), var(--uni-kasher-yellow), var(--uni-kasher-burgundy));
}

/* Keep startup and empty/error states calm: no layout jumps, no excessive motion. */
.uk-release-state button,
.uk-release-state a {
  will-change: transform;
}

/* Better native text selection/readability for support codes. */
.uk-support-code {
  user-select: text;
  word-break: break-word;
}

/* Release-grade keyboard shortcut hint. */
.uk-shortcut-hint {
  display: inline-flex;
  align-items: center;
  min-height: 1.4rem;
  padding-inline: .4rem;
  border: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
  border-radius: .45rem;
  background: color-mix(in srgb, var(--muted) 75%, transparent);
  font-family: var(--font-mono);
  font-size: .65rem;
  line-height: 1;
}

@media (prefers-reduced-motion: reduce) {
  .uk-release-state button,
  .uk-release-state a {
    will-change: auto;
  }
}



/* ============================================================
   PHASE 10A — Contrast & Surface Clarity
   ============================================================ */
:root {
  --uk-surface-strong: #fffdf8;
  --uk-surface-soft: #faf6ec;
  --uk-border-strong: #b9adbf;
  --uk-text-strong: #160029;
  --uk-text-muted: #514659;
  --uk-hover: #f2e6ec;
}

.dark {
  --uk-surface-strong: #25132c;
  --uk-surface-soft: #2b1832;
  --uk-border-strong: #64485f;
  --uk-text-strong: #F5EFE2;
  --uk-text-muted: #d7c9d5;
  --uk-hover: #3a2140;
}

/* Surfaces must read as surfaces — never transparent white-on-white. */
[data-slot="card"],
.unikasher-card {
  background-color: var(--uk-surface-strong) !important;
  border-color: var(--uk-border-strong) !important;
  color: var(--uk-text-strong);
}

[data-slot="input"] {
  background-color: var(--uk-surface-strong) !important;
  border-color: var(--uk-border-strong) !important;

  .uk-motion-base,
  .uk-motion-slow {
    transition-duration: 0.01ms !important;
  }
}

@media (forced-colors: active) {
  :where(button, a, input, textarea, select, [role='button']):focus-visible {
    outline: 2px solid CanvasText !important;
    box-shadow: none !important;

[data-slot='textarea'],
[data-slot='select-trigger'] {
  background: var(--uk-control-bg);
  color: hsl(var(--foreground));
  border-color: color-mix(in oklab, hsl(var(--border)) 86%, #D44D5C 14%);
}
[data-slot='input']:hover,
[data-slot='textarea']:hover,
[data-slot='select-trigger']:hover {
  background: var(--uk-control-bg-hover);
  border-color: color-mix(in oklab, #D44D5C 30%, hsl(var(--border)));
}
[data-slot='input']::placeholder,
[data-slot='textarea']::placeholder {
  color: hsl(var(--muted-foreground));
  opacity: 1;
}
[data-slot='input']:disabled,
[data-slot='textarea']:disabled,
[data-slot='select-trigger']:disabled {
  background: color-mix(in oklab, hsl(var(--muted)) 88%, hsl(var(--background)));
  color: hsl(var(--muted-foreground));
}

/* Radix portals: never transparent by default. */
[data-slot='dialog-content'],
[data-slot='alert-dialog-content'],
[data-slot='sheet-content'],
[data-slot='popover-content'],
[data-slot='hover-card-content'],
[data-slot='dropdown-menu-content'],
[data-slot='context-menu-content'],
[data-slot='select-content'],
[data-slot='command-content'] {
  background-color: hsl(var(--popover)) !important;
  color: hsl(var(--popover-foreground)) !important;
  border-color: hsl(var(--border)) !important;
  box-shadow: 0 24px 70px -30px rgba(22, 0, 41, 0.48) !important;
  opacity: 1 !important;
}
[data-slot='dialog-overlay'],
[data-slot='alert-dialog-overlay'] {
  background: var(--uk-overlay) !important;
}

/* Clear selected/hover states for menu systems without relying on color alone. */
[data-slot='dropdown-menu-item']:hover,
[data-slot='context-menu-item']:hover,
[data-slot='command-item'][data-selected='true'],
[data-slot='select-item']:focus {
  background: color-mix(in oklab, #E8E5A4 34%, hsl(var(--card))) !important;
  color: hsl(var(--foreground)) !important;
}
.dark [data-slot='dropdown-menu-item']:hover,
.dark [data-slot='context-menu-item']:hover,
.dark [data-slot='command-item'][data-selected='true'],
.dark [data-slot='select-item']:focus {
  background: color-mix(in oklab, #772344 48%, hsl(var(--card))) !important;
  color: #F5EFE2 !important;
}

/* Intentional internal scrolling: keep it local and predictable. */
.uk-scroll-region {
  overflow: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  min-height: 0;
}
.uk-scroll-region-x {
  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-inline: contain;
  scrollbar-gutter: stable;
}

/* Avoid accidental layout jumps when dialogs and menus open. */
html { scrollbar-gutter: stable; }

/* Motion remains subtle and never blocks interaction. */
.uk-motion-fast { transition-duration: 150ms; }
.uk-motion-base { transition-duration: 200ms; }
.uk-motion-slow { transition-duration: 260ms; }

@media (max-width: 767px) {
